<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the "XPlat Code Coverage" collector used by CI.
  SonarQube reads OpenCover reports (sonar.cs.opencover.reportsPaths), while
  coverlet writes Cobertura by default, so the format must be set here.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <!-- EF Core migrations are generated code. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
